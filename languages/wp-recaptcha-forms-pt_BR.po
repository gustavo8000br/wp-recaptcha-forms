msgid "Consentimento antes de carregar o script do Google"
msgstr "Consentimento antes de carregar o script do Google"

msgid "Consentimento: automático (%s). Sem provedor, o comportamento é o mesmo de \"não exigir\"."
msgstr "Consentimento: automático (%s). Sem provedor, o comportamento é o mesmo de \"não exigir\"."

msgid "Consentimento: exigido (%s). Sem sinal de consentimento o script do Google não é carregado e os envios chegam como \"navegador não alcançou o Google\"."
msgstr "Consentimento: exigido (%s). Sem sinal de consentimento o script do Google não é carregado e os envios chegam como \"navegador não alcançou o Google\"."

msgid "Consentimento: não exigido — o script do Google carrega em toda página com formulário protegido."
msgstr "Consentimento: não exigido — o script do Google carrega em toda página com formulário protegido."

msgid "Definida pela constante WP_RECAPTCHA_FORMS_SECRET_KEY em wp-config.php, que tem precedência sobre este campo."
msgstr "Definida pela constante WP_RECAPTCHA_FORMS_SECRET_KEY em wp-config.php, que tem precedência sobre este campo."

msgid "Degradado — não verificando. As chaves foram recusadas pelo Google e os formulários estão passando sem verificação."
msgstr "Degradado — não verificando. As chaves foram recusadas pelo Google e os formulários estão passando sem verificação."

msgid "Deixe em branco para manter a secret atual. Ao salvar uma secret nova, ela é validada com o Google — o que prova que a secret está correta, mas não prova que a site key é do mesmo projeto."
msgstr "Deixe em branco para manter a secret atual. Ao salvar uma secret nova, ela é validada com o Google — o que prova que a secret está correta, mas não prova que a site key é do mesmo projeto."

msgid "Deixe em branco para usar o texto padrão, já traduzido."
msgstr "Deixe em branco para usar o texto padrão, já traduzido."

msgid "Desativado — a constante WRF_DISABLE está definida em wp-config.php e nenhum formulário está sendo verificado."
msgstr "Desativado — a constante WRF_DISABLE está definida em wp-config.php e nenhum formulário está sendo verificado."

msgid "Enviar o endereço IP do visitante ao Google junto com a verificação"
msgstr "Enviar o endereço IP do visitante ao Google junto com a verificação"

msgid "Envio reprovado pelo Google"
msgstr "Envio reprovado pelo Google"

msgid "Envios com score abaixo deste valor são bloqueados. 0.6 é um ponto de partida conservador. Só vale para o v3."
msgstr "Envios com score abaixo deste valor são bloqueados. 0.6 é um ponto de partida conservador. Só vale para o v3."

msgid "Envios que o Google verificou e reprovou são sempre bloqueados — isso não é configurável, porque torná-lo configurável desligaria o plugin por padrão."
msgstr "Envios que o Google verificou e reprovou são sempre bloqueados — isso não é configurável, porque torná-lo configurável desligaria o plugin por padrão."

msgid "Esse processamento está sujeito à Política de Privacidade (%1$s) e aos Termos de Serviço (%2$s) do Google."
msgstr "Esse processamento está sujeito à Política de Privacidade (%1$s) e aos Termos de Serviço (%2$s) do Google."

msgid "Estado declarado pelo navegador quando a verificação não pôde ser obtida."
msgstr "Estado declarado pelo navegador quando a verificação não pôde ser obtida."

msgid "Este site usa o reCAPTCHA do Google para proteger formulários contra envios automatizados. Ao interagir com um formulário protegido, o seu navegador carrega um script servido pelo Google, o que expõe ao Google o seu endereço IP, informações do navegador e cookies do domínio google.com."
msgstr "Este site usa o reCAPTCHA do Google para proteger formulários contra envios automatizados. Ao interagir com um formulário protegido, o seu navegador carrega um script servido pelo Google, o que expõe ao Google o seu endereço IP, informações do navegador e cookies do domínio google.com."

msgid "Este texto é um ponto de partida para a sua política de privacidade. Ele não é aconselhamento jurídico e não torna a instalação conforme à LGPD ou ao GDPR."
msgstr "Este texto é um ponto de partida para a sua política de privacidade. Ele não é aconselhamento jurídico e não torna a instalação conforme à LGPD ou ao GDPR."

