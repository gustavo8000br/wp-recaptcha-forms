msgid "A constante WRF_DISABLE está definida em wp-config.php. Nenhum formulário está sendo verificado pelo reCAPTCHA. Remova a constante para retomar a proteção."
msgstr "A constante WRF_DISABLE está definida em wp-config.php. Nenhum formulário está sendo verificado pelo reCAPTCHA. Remova a constante para retomar a proteção."

msgid "A proteção do WP reCAPTCHA Forms está desativada pela constante WRF_DISABLE em wp-config.php. Nenhum formulário está sendo verificado."
msgstr "A proteção do WP reCAPTCHA Forms está desativada pela constante WRF_DISABLE em wp-config.php. Nenhum formulário está sendo verificado."

msgid "A proteção do WP reCAPTCHA Forms está desativada por constante"
msgstr "A proteção do WP reCAPTCHA Forms está desativada por constante"

msgid "A secret key foi recusada pelo Google e não foi salva. Confira se você copiou a secret key (não a site key) do mesmo projeto no console."
msgstr "A secret key foi recusada pelo Google e não foi salva. Confira se você copiou a secret key (não a site key) do mesmo projeto no console."

msgid "A secret key foi salva, mas não foi possível validá-la agora: o servidor não conseguiu falar com o Google. A validação acontece de novo na primeira verificação real."
msgstr "A secret key foi salva, mas não foi possível validá-la agora: o servidor não conseguiu falar com o Google. A validação acontece de novo na primeira verificação real."

msgid "A verificação de segurança está temporariamente indisponível. Tente novamente em instantes."
msgstr "A verificação de segurança está temporariamente indisponível. Tente novamente em instantes."

msgid "Abrir as configurações"
msgstr "Abrir as configurações"

msgid "Ainda não configurado — informe a site key e a secret key para começar a proteger os formulários."
msgstr "Ainda não configurado — informe a site key e a secret key para começar a proteger os formulários."

msgid "Além disso, o endereço IP do visitante é enviado ao Google pelo servidor deste site, junto com a verificação de cada envio de formulário."
msgstr "Além disso, o endereço IP do visitante é enviado ao Google pelo servidor deste site, junto com a verificação de cada envio de formulário."

msgid "As chaves do reCAPTCHA foram recusadas pelo Google. Os formulários continuam funcionando, mas sem verificação alguma."
msgstr "As chaves do reCAPTCHA foram recusadas pelo Google. Os formulários continuam funcionando, mas sem verificação alguma."

msgid "As chaves do v2 e do v3 não são intercambiáveis. Ao trocar de versão, gere um par de chaves novo no console do Google para a versão escolhida."
msgstr "As chaves do v2 e do v3 não são intercambiáveis. Ao trocar de versão, gere um par de chaves novo no console do Google para a versão escolhida."

msgid "As verificações estão funcionando."
msgstr "As verificações estão funcionando."

