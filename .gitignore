# Environment & Secrets
.env
.env.local
.env.*.local
*.key
*.pem

# Ambiente de teste local (Docker, dados/volumes)
test-env/

# Dependências
vendor/
node_modules/
composer.lock

# Build & distribuição
#
# `/dist/` e `/build/` com barra inicial, ancorados na raiz: o padrão solto `dist/`
# casava também `assets/js/dist/`, que é EXATAMENTE o que precisa estar versionado —
# o `.distignore` exclui `assets/js/src/` do zip e inclui o `dist/`. Sem isto, o zip
# publicado sai sem JavaScript nenhum: o campo é impresso, o script dá 404, o token
# nunca é obtido e o plugin deixa de verificar em silêncio.
/dist/
/build/
*.zip

# Artefatos do pseudo-locale: gerados pelo gate de i18n a cada execução, nunca versionados.
# Os .mo dos idiomas MANTIDOS (pt_BR, en_US, es_ES) SÃO versionados de propósito — a regra
# assimétrica da Story 1.21 AC 9: idioma mantido entra com .po e .mo, e o CI valida que os
# dois batem; idioma de comunidade entra só com .po.
languages/*-en_CA.po
languages/*-en_CA.mo

# Logs
*.log
logs/

# IDE & OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Cache do PHPUnit
.phpunit.result.cache
