{
    "name": "gustavo8000br/wp-recaptcha-forms",
    "description": "Protege formulários do WordPress, WooCommerce e Newsletter com o reCAPTCHA do Google.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "wp-coding-standards/wpcs": "^3.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "WpRecaptchaForms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WpRecaptchaForms\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "test": "phpunit",
        "check:boundary": "bash bin/check-boundary.sh"
    }
}
