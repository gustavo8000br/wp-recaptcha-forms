# Arquivos que NÃO entram no zip de distribuição (instalável no WordPress).
# Consumido pelo workflow de release (.github/workflows/release.yml) via rsync --exclude-from.
# Tudo que não está listado aqui é considerado runtime do plugin e vai pro zip —
# incluindo README.md, README-EN.md, LICENSE e languages/*.po (fonte de tradução).

.git/
.github/
.gitignore
.distignore
.editorconfig
.phpunit.result.cache

test-env/
tests/
bin/
build/

# `docs/` fica de fora, screenshots inclusive. Consequência aceita: as imagens do README
# não resolvem dentro do zip. Elas existem para quem lê o README no GitHub, que é onde ele
# é de fato lido — o WordPress não renderiza `README.md` de plugin (ele lê `readme.txt`).
# A alternativa seria embarcar 600 KB de PNG em toda instalação para uma página que o
# painel nunca mostra.
docs/

CONTRIBUTING.md

composer.json
composer.lock
phpunit.xml.dist
phpunit.xml
phpcs.xml.dist
phpcs.xml

# Código-fonte JS não minificado — só o build em assets/js/dist/ vai pro zip.
assets/js/src/

# Documentação de contribuição de tradução é conteúdo de repositório, não de runtime.
languages/README.md

*.zip
